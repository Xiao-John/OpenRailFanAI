# ===== LLM（OpenAI 兼容接口）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
# 结构化（意图/抽取）建议用更强模型，可为空则沿用 LLM_MODEL
LLM_STRUCTURED_MODEL=
# LLM_MOCK=true：不走真实模型，用确定性本地 mock 跑通整链（无 Key 演示/CI）
LLM_MOCK=false

# ===== 多供应商（可选：用户自备 Key、多家混用）=====
# 选中的供应商 id：内置有 deepseek / openai / siliconflow / dashscope / zhipu /
# moonshot / openrouter / gemini / ollama / lmstudio / vllm；留空则用上面的默认供应商
LLM_PROVIDER=
# 追加自定义供应商（JSON 对象或数组）。例：
# LLM_PROVIDERS={"mygw":{"label":"公司网关","base_url":"https://llm.corp.com","api_key":"sk-xxx","model":"qwen-plus"}}
# 字段：label / base_url / api_key / model / structured_model / api / extra_headers / extra_body / key_required
LLM_PROVIDERS=
# 供应商 JSON 文件路径（内容格式同 LLM_PROVIDERS，适合条目多或 Key 很长时用）
LLM_PROVIDERS_FILE=
# API 方言：auto（先试 chat_completions，遇 404/405 自动改试 responses）/ chat_completions / responses
LLM_API_DIALECT=auto
# 随请求下发的额外请求头 / 额外 body（JSON 对象），给需要自定义头的网关用
# LLM_EXTRA_HEADERS={"X-Gateway-Token":"xxx"}
LLM_EXTRA_HEADERS=
LLM_EXTRA_BODY=
# 单次 LLM 请求超时（秒）：推理模型首 token 较慢，别调太小
LLM_TIMEOUT_S=60.0
# 单次生成最大输出 token（含思考 token）。调小会让长回答在半句处被截断
LLM_MAX_TOKENS=4096
# 模型上下文窗口（token）。实际输出上限 = min(LLM_MAX_TOKENS, 窗口-输入-512)，
# 避免小窗口模型被上游 400 拒绝；各家差异大（8k/32k/128k/200k），按所用模型填；0=不约束
LLM_CONTEXT_TOKENS=32000
# 提示词 token 估算系数（字符数 ÷ 该系数 ≈ token，中文约 1.5），用于输出预算与超窗告警
LLM_CHARS_PER_TOKEN=1.5
# 是否允许 LLM 请求指向内网/环回地址（本地 Ollama 需要）。生产环境开启等于开放 SSRF，慎用
LLM_ALLOW_PRIVATE_BASE_URL=false

# ===== 服务器 =====
HOST=127.0.0.1
PORT=8000

# ===== 运行环境 =====
# dev / production。production 下会校验必须显式配置的密钥（缺失则拒绝启动）
APP_ENV=dev

# ===== 性能：决策层优化（2026-09-15）=====
# 确定性快路径：正则+本地站点库直接出意图/槽位，不打 LLM（覆盖约 56–68% 问法）；
# 出问题时置 false 一键回退纯 LLM 决策
FASTPATH_ENABLED=true
# 结构化调用（意图/槽位）关闭思考：此类任务思考 token 纯属延迟（实测 3.3s → 1.1s）
LLM_STRUCTURED_NO_THINK=true

# ===== 本地数据字典（里程/车站档案/离线时刻；2026-09-15）=====
# 由 scripts/mirror_dict.py 构建到 backend/data/dict.db（gitignored）：
#   python3 scripts/mirror_dict.py --all      # GTFS 周更快照 + 黄河铁路网线路汇总表
DICT_DB_PATH=data/dict.db
# 本地字典新鲜度（天）：GTFS 周更，超过该天数提示重新抓取
DICT_GTFS_MAX_AGE_DAYS=5
# 对黄河铁路网等个人站点的请求间隔下限（秒）——礼貌约束，勿调太小
DICT_SITE_MIN_INTERVAL_S=2.0

# ===== 前端代理目标（默认为后端根地址）=====
API_BASE=http://127.0.0.1:8000

# ===== 数据源（按需启用；留空表示不启用对应工具）=====
# 12306 反代/查询（参考 Parse12306）
T12306_BASE=
# rail.re：主站（页面抓取，已降级——主站为 SPA）与交路 API（车次↔担当车组，核心数据源）
RAILRE_BASE=https://rail.re
RAILRE_API_BASE=https://api.rail.re
# cnrail.geogv.org 铁路地图外链
CNRAIL_BASE=https://cnrail.geogv.org
# 黄河铁路网（客里表/电报码；rail.line 径路查询）
JPRAILFAN_BASE=https://jprailfan.com
# 95306 货运 / 昆铁货运 / 沈阳局余票（实测长期不可用，失败时会如实说明原因）
FREIGHT_95306_BASE=https://95306.cn
KMRAIL_BASE=https://kmrail.cn
SYTLJ_BASE=https://kyfw.sytlj.com
# 通用抓取：超时（秒）与单次响应体上限（字节，默认 2MB）
HTTP_TIMEOUT=12.0
HTTP_MAX_BYTES=2000000

# ===== 成本与输入治理 =====
# 单条用户消息字符上限（超限返回 422，不消耗 token）
MAX_MESSAGE_CHARS=2000
# 检索层工具并发度（工具之间无依赖；默认 3）
TOOL_CONCURRENCY=3
# 注入生成 prompt 的单条事实字符上限（表格类工具走结构化渲染，见 generate.py）
FACT_TEXT_MAX_CHARS=4000
# 表格类事实最多注入多少行（超出时显式标注省略行数）
FACT_TABLE_MAX_ROWS=40
# station.lookup 展示条数（本地索引排序后取前 N）
STATION_LIST_LIMIT=12
# station.screen（12306 车站大屏）单次下发的明细条数。接口一次返回全天 200–700 条，
# 必须裁剪后再进 prompt（超出部分由 ToolResult.total/truncated 如实登记）
STATION_SCREEN_LIMIT=15
# 按线路名查站序/指定径路的缓存（秒）——每次要抓 3 个约 800KB 页面
RAIL_LINE_CACHE_TTL_S=3600
# 离线车次目录缓存有效期（天）；超期后重新下载，下载失败回退旧缓存
TRAIN_CACHE_TTL_DAYS=30
# 12306 预售期参考值（天）：日期超出时在说明里点明“可能超预售期”，
# 避免把“本来就查不到”误述成“工具故障”
TICKET_PRESALE_DAYS=15
# 离线车次目录未命中时，用于"探测"该车次起止站的枢纽区间（形如 北京:上海,北京:广州）
HUB_PROBE_PAIRS=北京:上海,北京:广州,北京:哈尔滨,上海:广州

# ===== 前端静态目录（打包分发时用）=====
# 留空则按仓库布局推导（backend/app/../../frontend）。
# Android 一体化 / PyInstaller 等打包场景必须显式指定，否则主页 404。
FRONTEND_DIR=

# ===== 调试 / 运维 =====
# 是否输出 SQL 语句（排障用，日常关闭）
# 是否暴露 /docs、/redoc、/openapi.json（生产自动关闭）
ENABLE_API_DOCS=true
