{
  "schema": "intent-evaluation-codebook",
  "version": "1.2",
  "date": "2026-10-01",
  "namespace": "intent-evaluation-only",
  "runtime_contract_changed": false,
  "requested_fields_rules": {
    "ordering": "lexicographic_unique",
