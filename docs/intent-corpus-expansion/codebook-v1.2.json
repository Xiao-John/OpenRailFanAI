  "time_basis": {
    "scheduled": "图定、公布或计划时刻/历时，包括图定经停站表",
    "actual": "实际时刻、位置、正晚点、实际历时或预计实际到达",
    "mixed": "同一完整单元明确要求图定与实际两种口径",
    "unspecified": "涉及运行时刻/历时但口径未确定",
    "not_applicable": "请求结果不涉及上述运行时刻/历时口径，允许事实随日期变化"
  },
  "disallowed_time_basis": [
    "reference",
    "retrieved_fact",
    "model_knowledge",
    "unresolved"
