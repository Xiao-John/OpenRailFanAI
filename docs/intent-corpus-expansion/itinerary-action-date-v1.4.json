  "resolves_prior_rule_dependencies": [
    "constraints-time-v1.3.json:unfrozen[1] itinerary references and leg ordering",
    "C-0008 invalid action single-date kind/precision mapping"
  ],
  "does_not_resolve": [
    "action execution/recovery policy",
    "unprovided physical railway line/service/date values",
    "other residual date text/window/inheritance cases"
  ],
  "itineraries": {
    "location": "expect.itineraries",
    "none_value": [],
    "required_keys": [
      "id",
      "legs",
      "sequence_order",
      "stays"
    ],
    "id_pattern": "I[1-9][0-9]* assigned by first mention",
    "leg_required_keys": [
      "leg_id",
      "leg_index",
      "origin",
      "destination",
      "date"
    ],
    "leg_id_pattern": "<itinerary_id>:L<zero_based_leg_index>",
    "leg_index_start": 0,
    "leg_index_contiguous": true,
    "sequence_order": "all leg IDs exactly once in input order",
    "unknown_endpoints_nullable": true,
    "endpoint_granularity": "preserve user city/station/location level; no automatic city-to-station conversion",
    "stay_required_keys": [
      "after_leg",
      "before_leg",
      "location",
      "amount",
      "unit",
      "approximate",
      "quote"
    ],
    "stay_unit": [
      "day",
      "week"
    ],
    "stay_amount": "positive number",
    "stay_approximate": "boolean",
    "stay_refs": "adjacent valid legs",
    "evidence": "specific fields and relations backed by original input; a frame is not a verified rail route"
  },
  "unit_reference": {
    "field": "query_unit.itinerary_ref",
    "none_value": null,
    "required_keys": [
      "itinerary_id",
      "scope",
      "leg_ids",
      "candidate_leg_sets"
    ],
    "scope": {
      "leg": {
        "leg_ids": "one valid leg ID",
        "candidate_leg_sets": []
      },
      "all_legs": {
        "leg_ids": "full itinerary.sequence_order",
        "candidate_leg_sets": [],
        "condition": "user explicitly requests an aggregate/composite whole-trip result"
      },
      "unresolved": {
        "leg_ids": [],
        "candidate_leg_sets": "distinct evidence-supported ordered leg ID sets; unavailable candidates require explicit pending"
      }
    },
    "validate": [
      "frame exists",
      "all referenced legs exist",
      "leg bindings match corresponding endpoints",
      "order preserved",
      "candidate scope never silently selected"
    ],
    "legacy_fields_to_replace": [
      "task.sequence_order as leg ordering",
      "unit.leg_index duplicate"
    ],
    "not_a_constraint_key": true
  },
  "unit_granularity": {
    "per_leg_operations": [
      "train.timetable",
      "train.stops",
      "ticket.fare",
      "ticket.availability"
    ],
    "condition": "request explicitly concerns the segments of the itinerary; whole-trip aggregate exception requires explicit wording",
    "unknown_service": "train=null, preserve segment reference and pending service selection; never choose first returned service",
    "unresolved_scope": "one relationship node retaining scope candidates; do not expand candidate combinations",
    "sequence_relation": "primary itinerary service/time request",
    "independent_relation": "per-segment auxiliary stop/fare/availability requests; itinerary supplies ordering",
    "depends_on": "real semantic dependency only, never task list position or tool step count"
  },
  "temporal_scope": {
    "departure_window": "bind to the departure leg, do not assume whole itinerary completion within window",
    "approximate_stay": "stays gives event anchor for subsequent relative_period/vague; never clock+exact days",
    "sequence_only": "retain order without manufacturing a calendar date",
    "context_only_requests": "generic spots/route-membership without a shooting/operation time get omitted date while retaining itinerary_ref",
    "explicit_time_request": "bind supported query time, not a permanent per-operation omitted-date rule",
    "same_message_reference_source": "current, not history_user"
  },
  "invalid_action_date": {
    "condition": "date is already established invalid and source is a declared single-date action slot",
    "slot_path": "/date relative to display_action",
    "kind": "calendar_day",
    "precision": "unresolved",
    "state": "invalid",
    "direction": null,
    "resolved": null,
    "resolved_range": null,
    "resolved_instant": null,
    "window_raw": null,
    "time_filters": [],
    "raw": "original action value; for C-0008 the string not_a_date",
    "source_required": [
      "source=display_action",
      "history_index=null",
      "quote=original value",
      "path=/date"
    ],
    "priority": "this invalid declared-slot precision overrides generic calendar_day/day normal form",
    "untyped_invalid": "unresolved/unresolved with retained value/source/reason",
    "missing_or_schema_allowed_empty": "not made invalid by this rule",
    "other_natural_language_invalid_precision": "not frozen by this patch",
    "expect_time": "mirror invalid/raw/null resolved_date/null window_raw for this sole time candidate",
    "execution_policy_changed": false
  },
